   "source": [
    "import numpy as np\n",
    "\n",
    "K_bad = np.array([[1., 2.], [2., 1.]])\n",
    "print(np.linalg.eigvalsh(K_bad))          \n",
    "c = np.array([1., -1.])\n",
    "print(c @ K_bad @ c)                      # <- squared norm\n",
    "print(K_bad[0,0] - 2*K_bad[0,1] + K_bad[1,1])   # <- squared distance"
   ]
  },
